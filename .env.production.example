# ==========================================
# Healthcare Record System - Production Config
# ==========================================
# WARNING: This file should never be committed with real values!
# Use environment-specific secrets management in production.

# Node Environment
NODE_ENV=production

# ==========================================
# Database Configuration
# ==========================================
# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=

# Redis Cloud connection string
# Format: redis://<username>:<password>@<host>:<port>
REDIS_URL=

# ==========================================
# Security Configuration
# ==========================================
# JWT Secrets (use strong, random 256-bit strings)
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption key for sensitive data (AES-256)
# Must be exactly 64 hex characters (256 bits)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session secret for cookie signing
SESSION_SECRET=

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=https://yourdomain.com

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# External Services
# ==========================================

# Email (Gmail or SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@yourdomain.com

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Twilio (for SMS and video calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# Razorpay (for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==========================================
# Monitoring & Error Tracking
# ==========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Application version (set by CI/CD)
APP_VERSION=1.0.0

# ==========================================
# Feature Flags
# ==========================================
ENABLE_SWAGGER=false
ENABLE_DEBUG_LOGGING=false
ENABLE_PERFORMANCE_MONITORING=true

# ==========================================
# Healthcare Compliance
# ==========================================
# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=730

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=30

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
ACCOUNT_LOCKOUT_MINUTES=30
